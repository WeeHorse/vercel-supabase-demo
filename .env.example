# Browser-exposed project URL and publishable key (not secrets).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-sb-publishable-key
NEXT_PUBLIC_APP_ENV=local

# Server-only privileged configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional admin demo endpoint: disabled when absent or shorter than 32 chars.
# Use a random value, never a hard-coded teaching password.
ADMIN_API_SECRET=

# Optional: separate Supabase test project for RLS integration tests.
RLS_TEST_SUPABASE_URL=
RLS_TEST_SUPABASE_ANON_KEY=
RLS_TEST_USER_A_EMAIL=
RLS_TEST_USER_A_PASSWORD=
RLS_TEST_USER_B_EMAIL=
RLS_TEST_USER_B_PASSWORD=
